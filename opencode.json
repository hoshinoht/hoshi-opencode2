{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "update": "notify",
  "share": "disabled",
  "experimental": {
    "subagent_depth": 2
  },
  "agents": {

    "general": {
      "model": "openai/gpt-5.6-terra-1m#high"
      // "model": "anthropic/claude-opus-5-5#medium"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra-1m#high"
      // "model": "anthropic/claude-opus-5-5#medium"
    },
    "summary": {
      "model": "openai/gpt-6-luna#low"
      //"model": "openai/gpt-6-luna#low"
    },
    "title": {
      "model": "openai/gpt-6-luna#low"
      // "model": "openai/gpt-6-luna#low"
    }
  },
  "mcp": {
    "servers": {
      "workplan": {
        // Shiori uses the current project's MCP root supplied by OpenCode.
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/vendor/shiori/shiori",
          "mcp",
          "--write-approval",
          "client"
        ],
        "codemode": true,
        "disabled": false
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        // Off 2026-10-05: 11 calls in 30 days; context7 and gofetch cover library docs and the web.
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "researcher-mcp": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "$HOME/.config/opencode/mcps/researcher-mcp/bin/researcher-mcp"
        ],
        "disabled": false
      },
      "gofetch": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "$HOME/.config/opencode/mcps/gofetch-mcp/bin/gofetch"
        ],
        "codemode": false,
        "disabled": false
      },
      "ats-tailor": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "uv run --project \"$ATS_TAILOR_PROJECT\" ats-tailor mcp --repo \"$ATS_TAILOR_DATA\""
        ],
        // https://github.com/hoshinoht/ats-tailor — set ATS_TAILOR_PROJECT (tool checkout) and
        // ATS_TAILOR_DATA (your resume repository) in the environment OpenCode starts in.
        "environment": { "ATS_TAILOR_PROJECT": "{env:ATS_TAILOR_PROJECT}", "ATS_TAILOR_DATA": "{env:ATS_TAILOR_DATA}" },
        "timeout": {
          "execution": 300000
        },
        "disabled": true
      },
      "lsp-tools": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "node $HOME/.config/opencode/mcps/lsp-tools-mcp/mcp-no-idle.mjs"
        ],
        "environment": {
          // Optional per-project override; without it the built-in server list applies
          // (TypeScript and Python need typescript-language-server and basedpyright from brew).
          "LSP_TOOLS_MCP_PROJECT_CONFIG": ".opencode/lsp.json"
        },
        "disabled": false
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "oauth": false,
        // Off 2026-10-05: 12 calls in 30 days.
        "disabled": true
      }
    }
  },
  "plugins": [
    // The custom plan agent owns repository artifacts, not ~/.opencode/plan.
    "-opencode.plan",
    // Skip ~/.claude/skills and ~/.agents/skills: they hold claude.ai-synced skills written for
    // Claude's own tools, which added ~11 KB of irrelevant entries to every skill listing.
    "-opencode.config.compatibility",
    {
      // Preserve lifecycle role checks while Shiori is served over MCP.
      "package": "./packages/workplan-permissions"
    },
    {
      "package": "./packages/reasoning-router",
      "options": {
        "diagnosticsLimit": 100,
        "providers": {
          "openai": {},
          "anthropic": { "option": "effort", "efforts": ["low", "medium", "high"] }
        },
        "providerAgentPolicy": {
          "anthropic": {
            "explore": { "def": "low", "min": "low", "max": "medium" },
            "tester": { "def": "low", "min": "low", "max": "medium" },
            "code-writer": { "def": "medium", "min": "low", "max": "medium" },
            "code-engineer": { "def": "medium", "min": "medium", "max": "high" },
            "frontend-engineer": { "def": "medium", "min": "low", "max": "medium" },
            "researcher": { "def": "medium", "min": "low", "max": "medium" },
            "document-writer": { "def": "medium", "min": "low", "max": "medium" },
            "document-proofreader": { "def": "low", "min": "low", "max": "medium" },
            "plan": { "def": "high", "min": "medium", "max": "high" },
            "plan-checker": { "def": "medium", "min": "medium", "max": "high" },
            "code-checker": { "def": "medium", "min": "low", "max": "high" },
            "oracle": { "def": "medium", "min": "medium", "max": "medium" }
          }
        }
      }
    },
    {
      "package": "./packages/openai-long-context"
    },

    {
      "package": "./packages/usage-tracker",
      "options": {
        "quotaReminderRemainingPercent": { "openai": 10, "anthropic": 10 }
      }
    },
    {
      "package": "./packages/docs"
    },
    {
      // subagent_stop: lets build/orchestrator interrupt their own child sessions.
      "package": "./packages/subagent-control"
    },
    {
      // Keeps inline images under a budget so screenshot-heavy sessions stay under request limits.
      "package": "./packages/image-budget"
    },
    {
      "package": "./packages/cache-guard",
      "options": {
        "mode": "advisory",
        "riskAfterMinutes": 30,
        "minCacheReadTokens": 10000
      }
    },
    "@ex-machina/opencode-anthropic-auth@next",
    // Desktop/sound alerts for permission prompts, finished sessions, errors and questions.
    // Replaces the built-in alerts, which cli.json turns off with "-opencode.notifications".
    "@mohak34/opencode-notifier@latest",
    // Model-invoked `compress` for long primary sessions; automatic pruning is off (see dcp.jsonc).
    "@tarquinen/opencode-dcp@latest",
    // Blocks destructive git/filesystem commands and secret reads. Keep the @latest spec (its
    // installer and doctor match on it); check with `npx -y cc-safety-net@latest doctor`.
    // "cc-safety-net@latest",
  ],
  "providers": {},
  "model": "openai/gpt-5.6-terra-1m"
  // "model": "anthropic/claude-opus-5-5"
}
